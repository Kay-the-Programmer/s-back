# ==========================================
# Database & Environment
# ==========================================
DATABASE_URL=postgresql://postgres:password@s-back-db:5432/salepilot
NODE_ENV=development
PORT=5000
DB_SSL=false
FRONTEND_URL=http://localhost:5173

# ==========================================
# Authentication & Security
# ==========================================
JWT_SECRET=your_super_secret_jwt_key
SUPERADMIN_EMAIL=superadmin@sale-pilot.com
SUPERADMIN_PASSWORD=your_secure_password
AUTH_USER_CACHE_TTL_MS=60000

# ==========================================
# Email / SMTP
# ==========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="SalePilot" <noreply@salepilot.com>

# ==========================================
# Firebase Configuration
# ==========================================
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=salepilot-XXXXX.firebaseapp.com
FIREBASE_PROJECT_ID=salepilot-XXXXX
FIREBASE_STORAGE_BUCKET=salepilot-XXXXX.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:XXXXX
FIREBASE_MEASUREMENT_ID=G-XXXXX

# ==========================================
# AI Features (Google Gemini)
# ==========================================
API_KEY=your_gemini_api_key

# ==========================================
# WhatsApp & Messaging
# ==========================================
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token
ENCRYPTION_KEY=default-secret-key-change-in-prod
# Meta App Secret (App Dashboard → App settings → Basic). Used to validate the
# X-Hub-Signature-256 on inbound webhooks. If unset, signature checks are skipped
# (fine for early testing; set it in production to reject forged payloads).
WHATSAPP_APP_SECRET=your_meta_app_secret
# Graph API version used for outbound sends. Bump when Meta deprecates one.
WHATSAPP_GRAPH_API_VERSION=v21.0

# ==========================================
# Facebook Pages (Social Marketing suite)
# ==========================================
# Meta App ID + Secret (App Dashboard → App settings → Basic). Same Meta app as
# WhatsApp can be reused. The App ID is also sent to the frontend for FB Login.
FACEBOOK_APP_ID=your_meta_app_id
FACEBOOK_APP_SECRET=your_meta_app_secret
FACEBOOK_GRAPH_API_VERSION=v21.0
# DEV: Social Marketing is free by default for testing. Set to "false" to charge
# (pair with VITE_SOCIAL_FREE=false on the frontend).
SOCIAL_FREE=true
# DEV: WhatsApp CRM messaging is free by default so developers can test without
# the premium paywall. Set to "false" to re-enable the paid add-on before billing.
# (Pair with VITE_WHATSAPP_FREE=false on the frontend.)
WHATSAPP_FREE=true

# ==========================================
# SMS (Africa's Talking)
# ==========================================
# Use AT_USERNAME=sandbox with a sandbox API key for testing (messages only reach
# the AT simulator). For live SMS use your production username + API key, and an
# approved sender id / shortcode.
AT_API_KEY=your_africas_talking_api_key
AT_USERNAME=sandbox
AT_SENDER_ID=
AT_DEFAULT_COUNTRY_CODE=260

# ==========================================
# Lenco (Payments/Billing)
# ==========================================
LENCO_SECRET_KEY=your_lenco_secret_key
LENCO_API_BASE_URL=https://api.lenco.co/access/v2

# ==========================================
# External APIs
# ==========================================
BARCODE_LOOKUP_API_KEY=your_barcode_lookup_key
VAPID_PUBLIC_KEY=your_vapid_public_key

# ==========================================
# Uploads (Cloudinary; unset = local /uploads volume)
# ==========================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# AI (Gemini)
# ==========================================
GOOGLE_AI_API_KEY=

# ==========================================
# Monetization knobs (all optional; defaults in code)
# ==========================================
TRIAL_DAYS=14
SUBSCRIPTION_GRACE_DAYS=3
FREE_PRODUCT_LIMIT=100
ANNUAL_DISCOUNT_PERCENT=20
PLAN_AUTO_CHARGE=true
PLAN_RENEW_LEAD_DAYS=3
PLAN_RENEW_MAX_ATTEMPTS=3
PLAN_RENEW_RETRY_HOURS=24
ADDON_AUTO_CHARGE=true
ADDON_PERIOD_DAYS=30
ADDON_RENEW_LEAD_DAYS=3
ADDON_RENEW_MAX_ATTEMPTS=3
ADDON_RENEW_RETRY_HOURS=24

# ==========================================
# Webhook signature secrets (recommended in prod)
# ==========================================
WHATSAPP_APP_SECRET=
APP_SECRET=

# ==========================================
# Debug / docs toggles (leave off in prod)
# ==========================================
ENABLE_API_DOCS=false
AUTH_DEBUG=false
CORS_ALLOW_DEV_ORIGINS=false
FIREBASE_DATABASE_ID=
