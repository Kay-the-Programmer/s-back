# ── Production environment for the OCI deployment ────────────────────────────
# Copy to `.env` on the server and fill in every value. Anything left as a
# placeholder will either crash on boot (good) or silently disable a feature.

# Deployment
NODE_ENV=production
PORT=5000
# Domain Caddy serves TLS for (must have a DNS A record → the VM's public IP)
API_DOMAIN=api.salepilot.space
# Used for CORS allow-list and links in emails
FRONTEND_URL=https://www.salepilot.space

# Database (docker-compose.prod.yml wires DATABASE_URL itself from this password)
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
DB_SSL=false

# Auth — MUST be a long random value; `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_LONG_RANDOM

# Superadmin seed (only used on FIRST database init)
SUPERADMIN_EMAIL=superadmin@sale-pilot.com
SUPERADMIN_PASSWORD=CHANGE_ME

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Firebase (Google sign-in, push)
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# AI (Gemini)
API_KEY=

# Payments (Lenco)
LENCO_SECRET_KEY=
LENCO_API_BASE_URL=https://api.lenco.co/access/v2

# WhatsApp Business
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
ENCRYPTION_KEY=
WHATSAPP_FREE=false
ACCESS_TOKEN=
APP_SECRET=
APP_ID=
VERIFY_TOKEN=

# SMS (Africa's Talking)
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
AT_DEFAULT_COUNTRY_CODE=+260

# Misc
BARCODE_LOOKUP_API_KEY=
VAPID_PUBLIC_KEY=
AUTH_USER_CACHE_TTL_MS=60000
